var (
	gameState int
	mode      int
	players   int
	playerType int

	hp     float64
	maxHP  float64
	damage float64

	level int
	tile  float64
	cols  int
	rows  int

	tick       int
	lastShot   int

	playerX   float64
	playerY   float64
	playerDir int

	score     int
	kills     int
	botsAlive int
	botCap    int
	botsSpawned bool
	blipsSpawned bool
	bulletsSpawned bool
	spawnID     int
	botRefillAt int

	botX [8]float64
	botY [8]float64
	botHP [8]float64
	botAlive [8]bool
	botDir [8]int
	botMoveTicks [8]int
	botFireAt [8]int

	bulletActive [16]bool
	bulletX [16]float64
	bulletY [16]float64
	bulletVx [16]float64
	bulletVy [16]float64
	bulletBounce [16]int
	bulletGhost [16]bool
	bulletDmg [16]float64
	bulletOwner [16]int

	randX float64
	randY float64


	godMode bool
	konamiIdx int

	statusText  string
	modeText    string
	playersText string
	typeText    string
)

func Absf(v float64) float64 {
	if v < 0 {
		return -v
	}
	return v
}

func CellCol(x float64) int {
	return int((x + 240) / tile)
}

func CellRow(y float64) int {
	return int((180 - y) / tile)
}

func WallNoise(c, r int) int {
	n := ((c*7+r*13)*31 + c*3 + r*5) % 100
	if n < 0 {
		n = -n
	}
	return n
}

func IsWallCell(c, r int) bool {
	if c <= 0 || r <= 0 || c >= cols-1 || r >= rows-1 {
		return true
	}
	if c%4 == 1 || c%4 == 2 {
		if r%4 == 1 || r%4 == 2 {
			if WallNoise(c, r) < 62 {
				return true
			}
		}
	}
	return false
}

func BlockedAt(x, y float64) bool {
	h := tile * 0.32
	if IsWallCell(CellCol(x-h), CellRow(y-h)) {
		return true
	}
	if IsWallCell(CellCol(x+h), CellRow(y-h)) {
		return true
	}
	if IsWallCell(CellCol(x-h), CellRow(y+h)) {
		return true
	}
	if IsWallCell(CellCol(x+h), CellRow(y+h)) {
		return true
	}
	return false
}

func LineClear(x1, y1, x2, y2 float64) bool {
	n := int((Absf(x2-x1) + Absf(y2-y1)) / (tile * 0.4))
	if n < 2 {
		return true
	}
	for i := 1; i < n; i++ {
		px := x1 + (x2-x1)*float64(i)/float64(n)
		py := y1 + (y2-y1)*float64(i)/float64(n)
		if IsWallCell(CellCol(px), CellRow(py)) {
			return false
		}
	}
	return true
}

func UpdateTexts() {
	if mode == 0 {
		modeText = "经典"
	} else {
		modeText = "肉鸽"
	}
	if players == 2 {
		playersText = "1v1"
	}
	if players == 4 {
		playersText = "4人"
	}
	if players == 8 {
		playersText = "8人"
	}
	if playerType == 0 {
		typeText = "平衡型"
	}
	if playerType == 1 {
		typeText = "速度型"
	}
	if playerType == 2 {
		typeText = "防御型"
	}
}

func MenuText() {
	statusText = "空格开始 | 1/2/3 选坦克 | C 切模式 | X 切人数"
}

func KonamiStep(k int) {
	seq := [12]int{0, 0, 2, 2, 3, 1, 3, 1, 4, 5, 4, 5}
	if konamiIdx >= 12 {
		konamiIdx = 0
	}
	if seq[konamiIdx] == k {
		konamiIdx++
		if konamiIdx == 12 {
			konamiIdx = 0
			if godMode {
				godMode = false
				statusText = "彩蛋：无敌模式关闭"
			} else {
				godMode = true
				statusText = "彩蛋：无敌模式开启"
			}
		}
	} else {
		if k == 0 {
			konamiIdx = 1
		} else {
			konamiIdx = 0
		}
	}
}

func PickSpot(minDist float64) bool {
	for i := 0; i < 300; i++ {
		c := int(rand(1, cols-2))
		r := int(rand(1, rows-2))
		if !IsWallCell(c, r) {
			x := -240 + (float64(c)+0.5)*tile
			y := 180 - (float64(r)+0.5)*tile
			if Absf(x-playerX)+Absf(y-playerY) > minDist {
				randX = x
				randY = y
				return true
			}
		}
	}
	return false
}

func StartGame() {
	level = 1
	tile = 12
	cols = 40
	rows = 30

	if playerType == 0 {
		maxHP = 1
		damage = 1
	}
	if playerType == 1 {
		maxHP = 1
		damage = 0.5
	}
	if playerType == 2 {
		maxHP = 2
		damage = 1
	}
	hp = maxHP
	playerX = -240 + 3.5*tile
	playerY = 180 - 3.5*tile
	playerDir = 1

	score = 0
	kills = 0
	tick = 0
	lastShot = -300
	botCap = players - 1
	botsAlive = 0
	botRefillAt = 500

	for i := 0; i < 16; i++ {
		bulletActive[i] = false
	}

	for i := 0; i < 8; i++ {
		botAlive[i] = false
		botHP[i] = 1
	}
	for i := 0; i < botCap; i++ {
		if PickSpot(tile * 6) {
			botX[i] = randX
			botY[i] = randY
		} else {
			botX[i] = 240 - 3.5*tile
			botY[i] = -180 + 3.5*tile
		}
		botHP[i] = 1
		botAlive[i] = true
		botDir[i] = 2
		botMoveTicks[i] = 10
		botFireAt[i] = 30
		botsAlive++
	}

	if !botsSpawned {
		for i := 0; i < 8; i++ {
			spawnID = i
			Bot.clone
		}
		botsSpawned = true
	}

	statusText = ""
	UpdateTexts
	gameState = 1
}

func KillBot(id int) {
	if !botAlive[id] {
		return
	}
	botAlive[id] = false
	botsAlive--
	score += 10
	kills++
	if mode == 0 && botsAlive <= 0 {
		gameState = 2
		statusText = "全歼人机！按空格返回菜单"
	}
}

func DamagePlayer(d float64) {
	if gameState != 1 {
		return
	}
	if godMode {
		return
	}
	hp = hp - d
	if hp <= 0 {
		gameState = 2
		statusText = "坦克阵亡！按空格返回菜单"
	}
}

func SpawnBullet(owner int, x, y, vx, vy float64, bounces int, ghost bool, dmg float64) {
	for i := 0; i < 16; i++ {
		if !bulletActive[i] {
			bulletActive[i] = true
			bulletX[i] = x
			bulletY[i] = y
			bulletVx[i] = vx
			bulletVy[i] = vy
			bulletBounce[i] = bounces
			bulletGhost[i] = ghost
			bulletDmg[i] = dmg
			bulletOwner[i] = owner
			return
		}
	}
}

func FireShot(owner int) {
	if gameState != 1 {
		return
	}
	ox := 0.0
	oy := 0.0
	bounces := 0
	ghost := false
	dmg := 1.0
	speed := tile * 0.36
	if owner == 1 {
		if tick-lastShot < 33 {
			return
		}
		lastShot = tick
		ox = playerX
		oy = playerY
		bounces = 4
		dmg = damage
	} else {
		ox = botX[spawnID]
		oy = botY[spawnID]
		speed = tile * 0.3
	}
	vx := 0.0
	vy := 0.0
	if owner == 1 {
		if playerDir == 0 {
			vy = speed
		}
		if playerDir == 1 {
			vx = speed
		}
		if playerDir == 2 {
			vy = -speed
		}
		if playerDir == 3 {
			vx = -speed
		}
		if playerDir == 4 {
			vx = speed * 0.7
			vy = speed * 0.7
		}
		if playerDir == 5 {
			vx = speed * 0.7
			vy = -speed * 0.7
		}
		if playerDir == 6 {
			vx = -speed * 0.7
			vy = -speed * 0.7
		}
		if playerDir == 7 {
			vx = -speed * 0.7
			vy = speed * 0.7
		}
	} else {
		d := botDir[spawnID]
		if d == 0 {
			vy = speed
		}
		if d == 1 {
			vx = speed
		}
		if d == 2 {
			vy = -speed
		}
		if d == 3 {
			vx = -speed
		}
	}
	SpawnBullet owner, ox, oy, vx, vy, bounces, ghost, dmg
}

func RefillBots() {
	for i := 0; i < botCap; i++ {
		if !botAlive[i] {
			if PickSpot(tile * 6) {
				botX[i] = randX
				botY[i] = randY
			} else {
				botX[i] = 240 - 3.5*tile
				botY[i] = -180 + 3.5*tile
			}
			botHP[i] = 1
			botAlive[i] = true
			botDir[i] = 2
			botMoveTicks[i] = 10
			botFireAt[i] = tick + 60
			botsAlive++
		}
	}
}

func GameTick() {
	if gameState != 1 {
		return
	}
	tick++
	if mode == 1 && tick >= botRefillAt {
		botRefillAt = tick + 500
		RefillBots
	}
}

onStart => {
	MenuText
	UpdateTexts
	if !blipsSpawned {
		for i := 0; i < 8; i++ {
			spawnID = i
			Blip.clone
		}
		blipsSpawned = true
	}
	if !bulletsSpawned {
		for i := 0; i < 16; i++ {
			spawnID = i
			Bullet.clone
		}
		bulletsSpawned = true
	}
	for {
		wait 0.03
		GameTick
	}
}
